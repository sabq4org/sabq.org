{
  "$schema": "https://schema.up.railway.app/v1.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "Dockerfile",
    "watchPatterns": [
      "/server/newsletterWorker.ts",
      "/server/auth.ts",
      "/server/db.ts",
      "/server/dbPoolConfig.ts",
      "/server/memoryCache.ts",
      "/server/notificationBus.ts",
      "/server/objectAcl.ts",
      "/server/objectStorage.ts",
      "/server/redis.ts",
      "/server/selectHelpers.ts",
      "/server/sessionFailoverStore.ts",
      "/server/storage.ts",
      "/server/lib/passkit/PassUpdateLogger.ts",
      "/server/services/aiNewsletter*.ts",
      "/server/services/adminArticleList.ts",
      "/server/services/articleViewCounterService.ts",
      "/server/services/email.ts",
      "/server/services/loyalty.ts",
      "/server/services/newsletter*.ts",
      "/server/services/phoneAuth.ts",
      "/server/services/sportsLang.ts",
      "/server/utils/internalAnnouncementTargeting.ts",
      "/server/utils/logger.ts",
      "/server/utils/pgError.ts",
      "/server/utils/slugTransliterator.ts",
      "/shared/**",
      "/package.json",
      "/package-lock.json",
      "/Dockerfile",
      "/.dockerignore",
      "/railway.newsletter-worker.json",
      "/tsconfig.json",
      "/drizzle.config.ts"
    ]
  },
  "deploy": {
    "startCommand": "node dist/newsletter-worker.js",
    "healthcheckPath": "/health",
    "healthcheckTimeout": 60,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 5
  }
}
