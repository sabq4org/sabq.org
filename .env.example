# ============================================================
# Local development — environment template
# ============================================================
# Copy to .env.local (gitignored) and fill in. `.env.local` overrides `.env`.
# Full production variable list (with per-key notes): .env.railway.example
# DO NOT commit a filled-in version of this file.

# --- Required to boot `npm run dev` ---
DATABASE_URL=                       # Postgres URL. Neon: append ?sslmode=require
DB_DRIVER=neon                      # neon (default, Neon/Replit) | pg (plain TCP Postgres)
SESSION_SECRET=                     # any 32+ char random string for local dev

# --- Recommended ---
REDIS_URL=                          # optional; falls back to in-memory cache/sessions
ENABLE_BACKGROUND_WORKERS=false     # keep cron jobs off while developing
SKIP_DB_MAINTENANCE=true            # skip boot-time maintenance against shared DBs

# --- AI features (each degrades gracefully when unset) ---
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=                     # from aistudio.google.com (NOT a generic GOOGLE_API_KEY)
ELEVENLABS_API_KEY=

# --- Images (Cloudflare Images — primary path for image/* uploads) ---
# All three set => image uploads go to Cloudflare Images. Unset locally is fine.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_IMAGES_TOKEN=
CLOUDFLARE_ACCOUNT_HASH=

# --- Object storage for non-image assets (default: local filesystem) ---
STORAGE_PROVIDER=local

# --- Email / SMS (optional locally) ---
# Transactional email uses MailerSend first, then SendGrid as fallback.
MAILERSEND_API_KEY=
SENDGRID_API_KEY=
FROM_EMAIL=
SENDGRID_FROM_EMAIL=
MAILERLITE_API_KEY=
MAILERLITE_WEBHOOK_SECRET=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
SKIP_TWILIO_VALIDATION=true
# Twilio Verify service SID (SMS OTP for phone login). Required for sendSMSOTP.
# TWILIO_VERIFY_SID=
# Optional: approved Verify custom template SID whose LAST line is:
#   @sabq.org #{{code}}
# Enables iOS domain-bound AutoFill with the sabq app (webcredentials:sabq.org).
# Create/approve in Twilio Console → Verify → Templates, then set here.
# TWILIO_VERIFY_TEMPLATE_SID=
# Approved WhatsApp template (Twilio Content API HX... SID) for AI-Hub critical
# alerts. Set to deliver alerts OUTSIDE the 24h window; unset falls back to
# free-form (delivers only inside the window). See docs/whatsapp-ai-alert-template.md
AI_ALERT_WHATSAPP_CONTENT_SID=

# --- Push notifications (env-only since 2026-06-10; unset = disabled w/ warning) ---
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_KEY_P8=
FCM_SERVER_KEY=

# --- SEO / IndexNow (env-only since 2026-06-10; unset = pings disabled) ---
INDEXNOW_KEY=

# --- World Cup 2026 hub (api-football.com — unset = /api/world-cup/* return 503) ---
APIFOOTBALL_KEY=

# التعليق النصي المباشر للمونديال (sportmonks.com — مكمّل لـAPI-Football).
# unset = /api/world-cup/commentary/* يرد 503 وتبويب «التغطية الحية» لا يظهر.
SPORTMONKS_API_TOKEN=

# بطولات توليد أخبار SportMonks الآلي (معرّفات SportMonks، فواصل). الافتراضي 732
# (المونديال). للموسم الجديد أضف مثلًا: روشن 944، كأس الملك 950، النخبة 1085.
# SPORTMONKS_NEWS_LEAGUES=732,944,950,1085

# النتيجة اللحظية الفائقة للمونديال (thesports.com — أسرع من SportMonks). أفضل
# جهد: unset = يبقى المزوّد خاملًا ويتراجع تلقائيًا إلى SportMonks ثم API-Football.
# يتطلّب التفعيل أيضًا إدراج عنوان خروج الإنتاج (Railway) في قائمة TheSports —
# والقائمة IPv4 فقط (الكود يُجبر IPv4 عبر node:https family:4).
THESPORTS_USER=
THESPORTS_SECRET=
# تغذية WebSocket/MQTT اللحظية (topic: thesports/football/match/v1).
# تعمل تلقائيًا مع ENABLE_BACKGROUND_WORKERS. للتعطيل: THESPORTS_MQTT_ENABLED=false
# اختياري: THESPORTS_MQTT_URL=wss://mq.thesports.com:443/mqtt
# THESPORTS_MQTT_ENABLED=
# THESPORTS_MQTT_URL=
# لغة أسماء TheSports: تُجلب عبر نقطة مرجعية `language/list` (قاموس name_ar مفهرس
# بـid الكيان)، لا عبر باراميتر نداء. THESPORTS_LANG=ar يفعّل تفضيل أسماء المزوّد
# العربية في الطبقة اللحظية (أفضل جهد، يتراجع للتعريب المحلي). unset = سلوك حالي.
THESPORTS_LANG=
# --- ضبط إشعارات الرياضة (VARA) ضدّ الإغراق/الأخطاء العابرة ---
# نافذة تأكيد البطاقات/الفار (ملّي ثانية): لا يخرج إشعار الحدث إلا بعد صموده في فيد
# المزوّد هذه المدّة (تتجاوز كاش الأحداث 12ث) — يقتل بطاقات المزوّد الوهمية التي
# تظهر ثم تُصحَّح وتختفي. افتراضي 20000. الرفع = أمان أكثر مقابل تأخير أطول.
SPORTS_CARD_CONFIRM_MS=20000
# حدّ «الصفقة العالمية البارزة» بالمبلغ (يورو): دونه لا تُعدّ بارزةً إلا بين ناديين
# معروفين. يمنع وسم كل انتقالٍ مغمور له مبلغٌ ضئيل كـ«بارز». افتراضي 8000000.
SPORTS_TRANSFER_MAJOR_MIN_EUR=8000000
# سقف إشعارات الانتقالات العالمية في الدورة الواحدة (الفائض يُعلَّم مرصودًا بلا إرسال).
SPORTS_TRANSFER_MAX_GLOBAL_PER_CYCLE=3
# --- دوري روشن السعودي (قسم رياضي مخفي قيد التطوير، يستخدم نفس APIFOOTBALL_KEY) ---
# unset/false = /api/saudi-league/* و/saudi-league مخفية (ترد 404). true = تُفعَّل.
SAUDI_LEAGUE_ENABLED=false
# الموسم؛ افتراضي 2025 (المتاح حاليًا). يُقلب إلى 2026 عند انطلاق الموسم القادم.
SAUDI_LEAGUE_SEASON=2025

# --- كأس خادم الحرمين الشريفين (King's Cup — API-Football league 504، نفس APIFOOTBALL_KEY) ---
# الموسم؛ unset = يحلّه المزوّد ديناميكيًّا (current). اضبطه صراحةً عند اللزوم.
KC_SEASON=2026
# مولّد أخبار كأس الملك (معاينة/تقرير آليّ). unset/false = معطّل. true = يعمل كل دقيقة.
KC_NEWS_ENABLED=false
# اختياري: نشر تلقائي (false = يحفظ مسودّات للمراجعة) وحدّ التوليد لكل دورة.
# KC_NEWS_AUTOPUBLISH=true
# KC_NEWS_MAX_PER_RUN=3

# --- Smart Radar — رادار سبق الذكي (unset = job disabled with startup log) ---
RADAR_ENABLED=false
# Telegram alerts for breaking radar matches (optional — unset = dashboard-only alerts)
TELEGRAM_BOT_TOKEN=
TELEGRAM_RADAR_CHAT_ID=
# Tuning (defaults shown)
# RADAR_MAX_ANALYZE_PER_RUN=12
# RADAR_AUTOTRANSFORM_MIN_SCORE=80
# RADAR_AUTO_TRANSFORM=true
# RADAR_RETENTION_DAYS=14
# X watches (رصدات إكس) — hybrid: يكفي أحد المفتاحين، والتوجيه auto يستخدم المتوفر.
# official = X API v2 pay-per-use (حسابات/ترندات)، twitterapi.io = بحث واسع أرخص.
X_API_BEARER_TOKEN=
TWITTERAPI_IO_API_KEY=
# WOEID لموقع الترندات (الافتراضي: السعودية)
# RADAR_X_TRENDS_WOEID=23424938

# --- أخبار واس (SPA News API) — استعراض/استيراد في لوحة التحكم (/dashboard/spa-news) ---
# لهما قيمتان افتراضيتان مدمجتان في الكود فتعمل الخدمة دون ضبط؛ اضبطهما للإنتاج
# وتدوير المفتاح عند الحاجة. النقاط /api/admin/spa-news/* (صلاحية articles.view/create).
# SPA_NEWS_BASE_URL=https://spa-news-lan.plain-water-0957.workers.dev
# SPA_NEWS_API_KEY=

# --- Sentry (مراقبة أخطاء الخادم) — اختياري: unset = معطّل مع تحذير عند الإقلاع ---
# أخطاء فقط (بلا tracing/profiling/logs — تستهلك الحصة). DSN مشروع Express من sabq.sentry.io
SENTRY_DSN=
