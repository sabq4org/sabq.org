# ============================================================
# Local development — environment template
# ============================================================
# Copy to .env.local (gitignored) and fill in. `.env.local` overrides `.env`.
# Full production variable list (with per-key notes): .env.railway.example
# DO NOT commit a filled-in version of this file.

# --- Required to boot `npm run dev` ---
DATABASE_URL=                       # Postgres URL. Neon: append ?sslmode=require
DB_DRIVER=neon                      # neon (default, Neon/Replit) | pg (plain TCP Postgres)
SESSION_SECRET=                     # any 32+ char random string for local dev

# --- Recommended ---
REDIS_URL=                          # optional; falls back to in-memory cache/sessions
ENABLE_BACKGROUND_WORKERS=false     # keep cron jobs off while developing
SKIP_DB_MAINTENANCE=true            # skip boot-time maintenance against shared DBs

# --- AI features (each degrades gracefully when unset) ---
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=                     # from aistudio.google.com (NOT a generic GOOGLE_API_KEY)
ELEVENLABS_API_KEY=

# --- Images (Cloudflare Images — primary path for image/* uploads) ---
# All three set => image uploads go to Cloudflare Images. Unset locally is fine.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_IMAGES_TOKEN=
CLOUDFLARE_ACCOUNT_HASH=

# --- Object storage for non-image assets (default: local filesystem) ---
STORAGE_PROVIDER=local

# --- Email / SMS (optional locally) ---
SENDGRID_API_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
SKIP_TWILIO_VALIDATION=true

# --- Push notifications (env-only since 2026-06-10; unset = disabled w/ warning) ---
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_KEY_P8=
FCM_SERVER_KEY=

# --- SEO / IndexNow (env-only since 2026-06-10; unset = pings disabled) ---
INDEXNOW_KEY=

# --- World Cup 2026 hub (api-football.com — unset = /api/world-cup/* return 503) ---
APIFOOTBALL_KEY=

# --- Smart Radar — رادار سبق الذكي (unset = job disabled with startup log) ---
RADAR_ENABLED=false
# Telegram alerts for breaking radar matches (optional — unset = dashboard-only alerts)
TELEGRAM_BOT_TOKEN=
TELEGRAM_RADAR_CHAT_ID=
# Tuning (defaults shown)
# RADAR_MAX_ANALYZE_PER_RUN=12
# RADAR_AUTOTRANSFORM_MIN_SCORE=80
# RADAR_AUTO_TRANSFORM=true
# RADAR_RETENTION_DAYS=14
