# ============================================================
# Frontend (Vercel) — environment template
# ============================================================
# Copy into Vercel → Project Settings → Environment Variables.
# Only VITE_* vars are exposed to the browser; never put server secrets here.
#
# Two modes:
#   1. PROXY MODE (default, recommended for first-day testing)
#      Leave VITE_API_URL EMPTY. Vercel rewrites in vercel.json forward
#      /api/* to the Railway backend. Browser sees same-origin = no CORS,
#      no cookie domain juggling. Slight edge-proxy latency.
#
#   2. DIRECT MODE (faster, requires .sabq.news cookie domain configured)
#      Set VITE_API_URL=https://api.sabq.news. Browser hits the API origin
#      directly. Requires backend COOKIE_SAMESITE=none + COOKIE_DOMAIN=.sabq.news.

# --- Mode selector ---
VITE_API_URL=                      # leave empty for PROXY mode
VITE_PUBLIC_SITE_URL=https://sabq.news

# --- Public analytics / 3rd-party (all browser-visible) ---
VITE_GA_ID=
VITE_GTM_ID=
VITE_SENTRY_DSN_PUBLIC=
VITE_RECAPTCHA_SITE_KEY=
VITE_TAP_PUBLIC_KEY=
VITE_GOOGLE_OAUTH_CLIENT_ID=

# --- Vercel build hints ---
DISABLE_REPLIT_PLUGINS=true        # keep cartographer/devBanner out of the bundle
