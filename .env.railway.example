# ============================================================
# Backend (Railway) — environment template
# ============================================================
# Copy these into Railway → Variables. Values shown as <...> are placeholders.
# DO NOT commit a filled-in version of this file.

# --- Core ---
NODE_ENV=production
PORT=                              # Railway injects this automatically; leave blank
SERVE_SPA=false                    # Headless: frontend lives on Vercel.
                                   # Default (unset) = SPA served, preserves Replit behavior.
                                   # ONLY set to "false" to enable headless mode.
TRUST_PROXY=1
SESSION_SECRET=<generate-32+ char random string>
JWT_SECRET=<generate-32+ char random string>

# --- Database ---
# For Railway PG: DB_DRIVER=pg + DATABASE_URL pointing at postgres.railway.internal
# For external Neon: DB_DRIVER=neon (default) + Neon URL with ?sslmode=require
DB_DRIVER=pg
DATABASE_URL=<railway internal pg url, e.g. postgresql://postgres:****@postgres.railway.internal:5432/railway>
REDIS_URL=                         # optional but recommended (Upstash/Railway Redis)

# --- Cross-origin (frontend on Vercel, shared parent domain) ---
FRONTEND_URL=https://sabq.org
ALLOWED_ORIGINS=https://sabq.org,https://www.sabq.org
FRONTEND_PREVIEW_PATTERN=^https://sabq-.*\.vercel\.app$
COOKIE_DOMAIN=.sabq.org
PUBLIC_SITE_URL=https://sabq.org
COOKIE_SAMESITE=none               # required when frontend & API are on different subdomains

# --- AI providers ---
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# Gemini key from https://aistudio.google.com — NOT a generic GOOGLE_API_KEY.
# Checked by ~13 services (nanoBananaService, visualAiService, ai-manager, etc.).
# Some services also accept AI_INTEGRATIONS_GEMINI_API_KEY as a Replit-proxy
# fallback; on Railway use GEMINI_API_KEY directly.
GEMINI_API_KEY=
ELEVENLABS_API_KEY=

# --- Email ---
MAILERSEND_API_KEY=
SENDGRID_API_KEY=
FROM_EMAIL=
SENDGRID_FROM_EMAIL=
MAILERLITE_API_KEY=
MAILERLITE_WEBHOOK_SECRET=

# --- SMS / WhatsApp ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_NUMBER=

# --- Images (Cloudflare Images — primary path for article/profile images) ---
# When these three are set, EVERY image upload (mime starts with image/) is
# routed to Cloudflare Images, regardless of STORAGE_PROVIDER below. The
# archive of historical images already lives in Cloudflare, so keep this on.
# Checked by isCloudflareConfigured() in server/services/cloudflareImagesService.ts.
#
# CLOUDFLARE_IMAGES_TOKEN scope: create the token in CF dashboard with
# permission "Account → Cloudflare Images → Edit" ONLY. Do NOT grant
# Account Settings / DNS / Workers / R2 / anything else — a leaked token
# with broader scope is catastrophic. Recommended TTL: 1 year, then rotate.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_IMAGES_TOKEN=
CLOUDFLARE_ACCOUNT_HASH=           # the imagedelivery.net account hash (NOT account id)

# --- Cloudflare cache purge (zone-level, separate from Images) ---
# Token scope: "Zone → Cache Purge → Purge" on sabq.org only.
# zones only. Distinct from CLOUDFLARE_IMAGES_TOKEN.
CLOUDFLARE_ZONE_ID=
CLOUDFLARE_API_TOKEN=

# Shared secret for POST /api/webhooks/deploy-cache-purge (auto-purge after deploy).
# Set the same value on Vercel as DEPLOY_WEBHOOK_SECRET plus:
#   DEPLOY_PURGE_URL=https://api.sabq.org/api/webhooks/deploy-cache-purge
# so build:client triggers a purge at the end of every frontend deploy.
DEPLOY_WEBHOOK_SECRET=

# --- Object storage (non-image assets: PDFs, audio, generic uploads) ---
# Images bypass this and go to Cloudflare Images above. This backend handles
# everything else.
# Pick ONE provider via STORAGE_PROVIDER:
#   "s3"    — Generic S3-compatible (Tigris on Railway, MinIO, AWS, etc.)
#   "r2"    — Cloudflare R2
#   "local" — filesystem fallback (default; ephemeral on Railway, don't use in prod)
STORAGE_PROVIDER=s3
S3_ENDPOINT=https://t3.storageapi.dev   # Tigris on Railway
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=auto                          # works for Tigris/R2; AWS needs real region
S3_PUBLIC_URL=                          # optional CDN URL fronting the bucket;
                                        # if unset, falls back to ${S3_ENDPOINT}/${S3_BUCKET}
# S3_FORCE_PATH_STYLE=true              # default true; set false only if your provider needs virtual-host style

# Legacy GCS / R2 (only needed for those providers)
GCS_PROJECT_ID=
GCS_KEYFILE_JSON=                  # paste the full service account JSON (single line)
R2_PUBLIC_URL=                     # e.g. https://cdn.sabq.org (used by R2 URL migration)

# --- Push notifications ---
# NOTE: the prefix is APNS_ (with S) — the code reads APNS_KEY_ID/APNS_TEAM_ID/
# APNS_KEY_P8 (or APNS_PRIVATE_KEY). Since 2026-06-10 these are env-only
# (hardcoded fallbacks removed); all three missing = push disabled with a warning.
FCM_SERVER_KEY=
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_KEY_P8=
APNS_BUNDLE_ID=com.sabq.sabqorg

# --- SEO / IndexNow ---
# Env-only since 2026-06-10. Public verification token (served at /{key}.txt);
# unset = IndexNow pings disabled and the key route is not registered.
INDEXNOW_KEY=

# --- OAuth ---
# Web Google client (Passport.js strategy on /api/auth/google — needs secret + redirect URIs).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Mobile Google clients — verifyIdToken on /api/v1/auth/google accepts ANY of these
# as the token `aud` claim. iOS app embeds GOOGLE_IOS_CLIENT_ID directly (its native
# OAuth client). Android Credential Manager requires a *Web* OAuth client ID as
# `serverClientId`, which becomes the `aud` claim on tokens issued to the app.
GOOGLE_IOS_CLIENT_ID=
GOOGLE_ANDROID_CLIENT_ID=
APPLE_CLIENT_ID=
APPLE_IOS_BUNDLE_ID=
# Audience تطبيق كأس آسيا المستقل (Sign in with Apple).
APPLE_ASIANCUP_BUNDLE_ID=com.sabq.asiancup
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=

# --- Sports data (API-Football — hubs: world-cup, gulf-cup, asian-cup, kings-cup) ---
# Single key powers all football hubs. Unset = those /api/*-cup/* return 503.
APIFOOTBALL_KEY=
# King's Cup (كأس الملك — league 504). Season; unset = provider resolves current.
KC_SEASON=2026
# Auto news generator for King's Cup (preview/report). false = disabled.
KC_NEWS_ENABLED=false
# KC_NEWS_AUTOPUBLISH=true            # false = save drafts for review
# KC_NEWS_MAX_PER_RUN=3

# --- Payments ---
TAP_SECRET_KEY=

# --- Filesystem (Railway is ephemeral; prefer R2/CF Images) ---
UPLOADS_DIR=/tmp/uploads
