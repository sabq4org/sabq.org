client/public/*.docx

# Native SwiftUI iOS app (sabq app ios/) is now TRACKED in git to protect
# its sources from accidental deletion and to ship perf fixes via the
# branch. Only build artifacts, DerivedData, Xcode user state, and the
# stray dated backup copy are ignored — never the sources.
sabq app ios/build/
sabq app ios/DerivedData/
sabq app ios/test-results/
sabq app ios/sabq 2026-05-18 08-30-20/
sabq app ios/**/xcuserdata/
sabq app ios/**/*.xcuserstate
