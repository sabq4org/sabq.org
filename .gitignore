MIGRATION_RUNBOOK.md

*.p12
sabq-press.p12

# Internal reports must NEVER live under client/public (served publicly).
# Keep authored copies under docs/ instead.
client/public/*.docx

# Native SwiftUI iOS app (sabq app ios/) is now TRACKED in git to protect
# its sources from accidental deletion and to ship perf fixes via the
# branch. Only build artifacts, DerivedData, Xcode user state, and the
# stray dated backup copy are ignored — never the sources.
sabq app ios/build/
sabq app ios/DerivedData/
sabq app ios/test-results/
sabq app ios/sabq 2026-05-18 08-30-20/
sabq app ios/**/xcuserdata/
sabq app ios/**/*.xcuserstate
# Sports SwiftUI app (sports app ios/) — sources tracked, build state ignored.
sports app ios/build/
sports app ios/DerivedData/
sports app ios/test-results/
sports app ios/**/xcuserdata/
sports app ios/**/*.xcuserstate
# Asian Cup SwiftUI app (asian-cup app ios/) — same rule.
asian-cup app ios/build/
asian-cup app ios/DerivedData/
asian-cup app ios/**/xcuserdata/
asian-cup app ios/**/*.xcuserstate
