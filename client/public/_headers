# Cloudflare Pages headers — mirrors the `headers` block in vercel.json.
# HTML cache-control (no-store) is handled in functions/_middleware.js so that
# both injected article pages AND noindex dashboard/admin routes stay private.

# Hashed, content-addressed bundle (Vite emits everything to /assets/).
/assets/*
  Cache-Control: public, max-age=31536000, immutable
  Access-Control-Allow-Origin: *
  Cross-Origin-Resource-Policy: cross-origin

# Deploy-detection probe — must never be cached, or open tabs miss new builds.
/build-info.json
  Cache-Control: no-cache, no-store, max-age=0, must-revalidate
