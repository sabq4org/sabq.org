# Cloudflare Pages headers — mirrors the `headers` block in vercel.json.
# HTML cache-control is handled per-route in functions/_middleware.js:
#   - indexable content (articles/categories/home) on sabq.org → edge-cacheable
#     (public, s-maxage=300, stale-while-revalidate) for fast Googlebot TTFB;
#   - noindex screens (dashboard/admin/auth) + non-canonical hosts → no-store.
# The client deploy-recovery guard (client/src/lib/deployRecovery.ts) reloads
# once on a stale-chunk error, so caching the shell never strands an open tab.

# Hashed, content-addressed bundle (Vite emits everything to /assets/).
/assets/*
  Cache-Control: public, max-age=31536000, immutable
  Access-Control-Allow-Origin: *
  Cross-Origin-Resource-Policy: cross-origin

# Deploy-detection probe — must never be cached, or open tabs miss new builds.
/build-info.json
  Cache-Control: no-cache, no-store, max-age=0, must-revalidate

# Universal Links association must be served as JSON without redirects.
/.well-known/apple-app-site-association
  Content-Type: application/json; charset=utf-8
  Cache-Control: public, max-age=300, must-revalidate
