    <!-- خلفية أيقونة المشغّل — أخضر VARA الداكن من أيقونة iOS (زاوية التدرج). -->
    <color name="vara_icon_background">#0A4330</color>
    <style name="Theme.Vara" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:fontFamily">@font/ibm_plex_sans_arabic_regular</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:navigationBarColor">@color/vara_launch_background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:windowActionModeOverlay">true</item>
    </style>
</resources>
