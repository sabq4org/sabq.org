{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build:client",
  "outputDirectory": "dist/public",
  "installCommand": "npm ci",
  "framework": null,
  "rewrites": [
    { "source": "/api/:path*", "destination": "https://api.sabq.org/api/:path*" },
    { "source": "/health", "destination": "https://api.sabq.org/health" },
    { "source": "/ready", "destination": "https://api.sabq.org/ready" },
    { "source": "/ads.txt", "destination": "https://api.sabq.org/ads.txt" },
    { "source": "/app-ads.txt", "destination": "https://api.sabq.org/app-ads.txt" },
    { "source": "/robots.txt", "destination": "https://api.sabq.org/robots.txt" },
    { "source": "/sitemap.xml", "destination": "https://api.sabq.org/sitemap.xml" },
    { "source": "/sitemap-:slug.xml", "destination": "https://api.sabq.org/sitemap-:slug.xml" },
    { "source": "/s/:code", "destination": "https://api.sabq.org/s/:code" },
    { "source": "/uploads/:path*", "destination": "https://api.sabq.org/uploads/:path*" },
    { "source": "/branding/:path*", "destination": "https://api.sabq.org/branding/:path*" }
  ],
  "headers": [
    {
      "source": "/((?!assets/|api/|_vercel/|.*\\.(?:js|css|map|json|xml|txt|ico|png|jpg|jpeg|gif|svg|webp|avif|woff|woff2|ttf|eot|pdf)).*)",
      "headers": [
        { "key": "Cache-Control", "value": "private, no-store, no-cache, must-revalidate, max-age=0, s-maxage=0, proxy-revalidate" },
        { "key": "CDN-Cache-Control", "value": "no-store, max-age=0, must-revalidate" },
        { "key": "Vercel-CDN-Cache-Control", "value": "no-store, max-age=0, must-revalidate" },
        { "key": "Surrogate-Control", "value": "no-store, max-age=0" },
        { "key": "Pragma", "value": "no-cache" },
        { "key": "Expires", "value": "0" }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/(.*)\\.(js|css|woff|woff2|ttf|eot|png|jpg|jpeg|gif|svg|webp|avif|ico)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ],
  "github": {
    "silent": true
  }
}
