{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build:client",
  "outputDirectory": "dist/public",
  "installCommand": "npm ci",
  "framework": null,
  "rewrites": [
    { "source": "/api/:path*", "destination": "https://sabqorg-production.up.railway.app/api/:path*" },
    { "source": "/health", "destination": "https://sabqorg-production.up.railway.app/health" },
    { "source": "/ready", "destination": "https://sabqorg-production.up.railway.app/ready" },
    { "source": "/sitemap.xml", "destination": "https://sabqorg-production.up.railway.app/sitemap.xml" },
    { "source": "/sitemap-:path*.xml", "destination": "https://sabqorg-production.up.railway.app/sitemap-:path*.xml" },
    { "source": "/robots.txt", "destination": "https://sabqorg-production.up.railway.app/robots.txt" },
    { "source": "/ads.txt", "destination": "https://sabqorg-production.up.railway.app/ads.txt" },
    { "source": "/app-ads.txt", "destination": "https://sabqorg-production.up.railway.app/app-ads.txt" },
    { "source": "/uploads/:path*", "destination": "https://sabqorg-production.up.railway.app/uploads/:path*" },
    { "source": "/branding/:path*", "destination": "https://sabqorg-production.up.railway.app/branding/:path*" }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/(.*)\\.(js|css|woff|woff2|ttf|eot|png|jpg|jpeg|gif|svg|webp|avif|ico)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ],
  "github": {
    "silent": true
  }
}
