  "scripts": {
    "dev": "NODE_ENV=development tsx server/index.ts",
    "build": "npm run build:client && npm run build:server",
    "build:client": "vite build",
    "build:server": "esbuild server/index.ts --outfile=dist/index.js --format=esm --platform=node --packages=external --bundle && esbuild server/bootstrap.ts --outfile=dist/bootstrap.js --format=esm --platform=node --packages=external --bundle --external:./index.js && esbuild server/newsletterWorker.ts --outfile=dist/newsletter-worker.js --format=esm --platform=node --packages=external --bundle",
    "start": "NODE_ENV=production node dist/index.js",
    "start:newsletter-worker": "NODE_ENV=production node dist/newsletter-worker.js",
    "check": "tsc",
    "check:tsc6": "tsc6",
    "lint": "eslint .",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:smoke": "playwright test e2e/smoke.spec.ts",
    "test:e2e": "playwright test",
    "test:load": "k6 run load-test/breaking-point.js",
    "db:push": "drizzle-kit push",
    "db:push:local": "bash scripts/db-push-local.sh",
    "db:up": "docker compose up -d postgres redis",
    "db:down": "docker compose stop postgres redis",
    "systems:inventory": "node scripts/systems-inventory.mjs --write-snapshot"
  },
