# Server-side origin the Next app calls for data (Railway API service).
# Required in production — SSR cannot use relative /api paths across services.
API_ORIGIN=https://api.sabq.org

# Public site origin (canonical URLs, OG metadataBase).
PUBLIC_SITE_URL=https://sabq.org

# Railway staging only: prevents indexing and changes responses to no-store.
# STAGING_NO_INDEX=true

# Railway staging only: Basic Auth password (username is "sabq").
# STAGING_ACCESS_TOKEN=<random staging-only secret>

# Optional: if set, hydrated client components call the API origin directly
# instead of relying on Cloudflare's /api/* proxy. Leave unset in proxy mode.
# NEXT_PUBLIC_API_URL=https://api.sabq.org

# Port Railway injects. `npm start` honors $PORT (defaults to 3001 locally).
# PORT=3001
