# Server-side origin the Next app calls for data (Render API service).
# Required in production — SSR cannot use relative /api paths across services.
API_ORIGIN=https://api.sabq.org

# Public site origin (canonical URLs, OG metadataBase).
PUBLIC_SITE_URL=https://sabq.org

# Staging only: prevents indexing and changes responses to no-store.
# STAGING_NO_INDEX=true

# Staging only: Basic Auth password (username is "sabq").
# STAGING_ACCESS_TOKEN=<random staging-only secret>

# Optional: if set, hydrated client components call the API origin directly
# instead of relying on Cloudflare's /api/* proxy. Leave unset in proxy mode.
# NEXT_PUBLIC_API_URL=https://api.sabq.org

# Port Render injects. `npm start` honors $PORT (defaults to 3001 locally).
# PORT=3001

# US 2026 midterms live strip under the header. Set to "false" to hide.
# NEXT_PUBLIC_ELECTIONS_STRIP_ENABLED=true
# NEXT_PUBLIC_ELECTIONS_URL=https://sabq-elections-preview.sabq-1ac.workers.dev
